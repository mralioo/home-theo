# Copy to .env and fill in. .env is git-ignored.

# Offline deterministic demo: leave USE_LLM=0 (no key needed).
# Real agentic mode: set USE_LLM=1 and provide ANTHROPIC_API_KEY.
USE_LLM=0
ANTHROPIC_API_KEY=
LITELLM_MODEL=anthropic/claude-sonnet-4-5-20250929

# Local SQLite path (inside the container).
DB_PATH=/data/ops.db

# --- Dev 3 (glue / realtime / webhooks) ---

# Shared secret for the ElevenLabs server-tool webhook. Verified by
# /webhooks/elevenlabs/tool against the X-Webhook-Secret header.
WEBHOOK_SECRET=

# Admin endpoints (reset, etc). X-Admin-Secret on /admin/* routes.
ADMIN_SECRET=

# ElevenLabs REST credentials for outbound vendor calls (T5).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_OUTBOUND=

# Set FAKE_ORCHESTRATOR=1 to bypass the real coordinator and emit canned
# StatusEvents — lets Dev 3 develop the dashboard with Devs 1/2 offline.
FAKE_ORCHESTRATOR=0
