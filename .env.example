# Copy to .env and fill in. .env is git-ignored.

# Offline deterministic demo: leave USE_LLM=0 (no key needed).
# Real agentic mode: set USE_LLM=1 and provide ANTHROPIC_API_KEY.
USE_LLM=0
ANTHROPIC_API_KEY=
LITELLM_MODEL=anthropic/claude-sonnet-4-5-20250929

# Local SQLite path (inside the container).
DB_PATH=/data/ops.db

CONTEXT_SERVICE_URL=http://context-service:8002

# Shared secret for the ElevenLabs server-tool webhook and admin endpoints.
WEBHOOK_SECRET=
ADMIN_SECRET=

# ElevenLabs credentials (STT transcription + outbound vendor calls).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_OUTBOUND=

# Set to 1 to bypass the real coordinator and emit canned StatusEvents (dev/test).
FAKE_ORCHESTRATOR=0
