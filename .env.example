# Copy to .env and fill in. .env is git-ignored.

# Offline deterministic demo: leave USE_LLM=0 (no key needed).
# Real agentic mode: set USE_LLM=1 and provide ANTHROPIC_API_KEY.
USE_LLM=0
ANTHROPIC_API_KEY=
LITELLM_MODEL=anthropic/claude-sonnet-4-5-20250929

# Local SQLite path (inside the container).
DB_PATH=/data/ops.db
